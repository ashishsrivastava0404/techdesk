DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_NAME=promote
PORT=3001
NODE_ENV=development

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Set to 'false' to disable Redis and use in-memory fallback
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=a_very_long_and_secure_random_64_character_secret_key_here_for_production_use
