DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_NAME=promote
PORT=3001
NODE_ENV=development

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Set to 'false' to disable Redis and use in-memory fallback
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
